{
  "name": "tako",
  "version": "0.1.2",
  "description": "TUI for managing docker-compose-based homelabs over SSH.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tako": "src/index.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "bash -c 'FILES=${UVU_FILES:-$(git diff --cached --name-only | tr \"\\n\" \" \")} && prettier --write $FILES'",
    "lint:changed": "bash -c 'FILES=${UVU_FILES:-$(git diff --cached --name-only | tr \"\\n\" \" \")} && eslint $FILES'",
    "typecheck": "tsc --noEmit",
    "generate:routes": "bun scripts/generate-routes.ts",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:e2e": "vitest run --project=e2e --passWithNoTests",
    "test:all": "vitest run",
    "test:coverage": "vitest run --project=unit --coverage",
    "dev": "bun --watch src/cli/index.ts",
    "start": "bun ./src/index.tsx",
    "prebuild": "bun scripts/generate-version.ts",
    "prestart": "bun scripts/generate-routes.ts",
    "build": "bun build src/index.tsx --compile --target=bun-linux-x64-modern --outfile dist/tako-linux-x64"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "dockerode": "^5.0.1",
    "ink": "^7.1.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "trustedDependencies": [
    "cpu-features",
    "protobufjs",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,tsx,js,jsx}": ["eslint --fix", "tsc --noEmit --pretty"],
    "*.{json,yml,yaml}": "prettier --write"
  }
}
